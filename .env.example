# ============================================================
# TRACE // VERIFY — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- SEARCH PROVIDERS ----
# SerpAPI (https://serpapi.com) — free tier available
SERPAPI_KEY=

# Bing Web Search API (Azure Cognitive Services)
BING_API_KEY=

# Google Custom Search API
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ---- BLOCKCHAIN ----
# Polygon Amoy Testnet RPC
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Your wallet private key for signing transactions
# NEVER commit a funded mainnet key here
WALLET_PRIVATE_KEY=

# Deployed EvidenceRegistry contract address (after deploying)
EVIDENCE_REGISTRY_ADDRESS=

# ---- BACKEND ----
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo mode: set to "true" to use cached fallback data when external APIs fail
DEMO_FALLBACK_ENABLED=true

# Face similarity threshold (0.0-1.0); candidates above this are MATCH
FACE_SIMILARITY_THRESHOLD=0.65

# Maximum candidates to fetch per search
MAX_CANDIDATES=20

# ---- STORAGE ----
# Uploaded files are deleted after investigation unless this is set to "true"
PERSIST_UPLOADS=false

# Temporary upload directory (relative to backend/)
UPLOAD_DIR=./tmp_uploads
